knitr::include_graphics("acf.png")
# Load necessary libraries
library(tidyverse)
library(lubridate)
library(ggplot2)
library(forecast)
library(tseries)
dailyaqi <- read_csv("../Data/London_AQI_Daily.csv")
dailyaqi$Date <- as.Date(dailyaqi$Date, format = "%Y-%m-%d")
# Plot the AQI data
ggplot(dailyaqi, aes(x=Date, y=USAQI)) +
geom_line() +
labs(title="AQI Over Time", x="Date", y="AQI")
# examine trends and autocorrelation
acf(dailyaqi$USAQI, main = "Autocorrelation of Daily AQI in London", col.main = "blue")
pacf(dailyaqi$USAQI, main = "Partial Autocorrelation of Daily AQI in London", col.main = "blue")
# check for stationarity
adf.test(dailyaqi$USAQI)
kpss.test(dailyaqi$USAQI)
